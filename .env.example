# AI ghost-text autocomplete provider
# "gemini" (default) or "nvidia"
NUXT_AI_PROVIDER=nvidia

# Gemini (Google AI Studio) - https://aistudio.google.com/app/apikey
NUXT_GEMINI_API_KEY=
# Optional: override default model
# NUXT_GEMINI_MODEL=gemini-3.5-flash-lite

# NVIDIA build.nvidia.com - https://build.nvidia.com/
# Used when NUXT_AI_PROVIDER=nvidia
NUXT_NVIDIA_API_KEY=
# Optional: override default model
# NVIDIA model is configured in wrangler.toml for Cloudflare deployments.
# Current example: openai/gpt-oss-20b

# Turso (libSQL) database
# Create a database at https://turso.tech and copy the URL + token
TURSO_URL=https://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Better Auth
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Your site origin, e.g. http://localhost:3000 (dev) or https://shbd.bioinfo.guru (prod)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (social login)
# Google Cloud Console -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (social login)
# GitHub -> Settings -> Developer settings -> OAuth Apps
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Typst PDF service (Google Cloud Run)
# URL of the deployed Cloud Run service, e.g. https://pdf-service-xxxx.a.run.app
NUXT_PDF_SERVICE_URL=
# Shared secret; must equal the PDF_SERVICE_API_KEY secret in GCP Secret Manager
# Generate with: openssl rand -hex 32
NUXT_PDF_SERVICE_KEY=

# Admin panel (route /admin)
# Comma-separated email allowlist. Only these signed-in accounts can access
# /api/admin/* endpoints and the /admin page data.
ADMIN_EMAILS=admin@example.com
